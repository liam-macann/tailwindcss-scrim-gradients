{
	"name": "tailwindcss-scrim-gradients",
	"description": "Generate beautiful gradient overlays with composable utilities.",
	"author": "Liam Macann",
	"version": "1.0.0",
	"source": "src/index.ts",
	"main": "dist/index.cjs",
	"types": "dist/index.d.cts",
	"exports": {
		".": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"license": "MIT",
	"keywords": [
		"tailwind",
		"tailwindcss",
		"gradients",
		"scrim",
		"plugin"
	],
	"files": [
		"/dist"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/liam-macann/tailwindcss-scrim-gradients.git"
	},
	"bugs": {
		"url": "https://github.com/liam-macann/tailwindcss-scrim-gradients/issues"
	},
	"prettier": {
		"printWidth": 100,
		"semi": true,
		"singleQuote": true,
		"trailingComma": "es5",
		"arrowParens": "avoid",
		"useTabs": true,
		"experimentalTernaries": true
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsdown src/index.ts --format cjs --dts",
		"format": "prettier --write .",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"tailwindcss": "^3.0.0 || ^4.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"postcss": "^8.2.4",
		"prettier": "^3.9.10",
		"tailwindcss": "^4.3.3",
		"tailwindcss-v3": "npm:tailwindcss@^3.4.19",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.2"
	}
}
